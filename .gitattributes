# Normalize line endings for all text files
* text=auto

# Source code
*.py text eol=lf
*.js text eol=lf
*.html text eol=lf
*.css text eol=lf
*.json text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.sh text eol=lf

# Documentation
*.md text eol=lf
*.txt text eol=lf
*.rst text eol=lf

# Binary files
*.h5 binary
*.pkl binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
